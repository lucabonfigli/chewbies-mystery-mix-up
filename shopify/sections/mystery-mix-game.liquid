{% comment %}
  Chewbie's Mystery Mix-Up — theme section

  Framing reverse-engineered from the live 2025 Easter build
  (sections/easter-mystery-game.liquid on this store): full-bleed background
  image, a centred column, and a FIXED-HEIGHT frame rather than a ratio —
  900px, dropping to 866px at 1152px and above. Width is 90% capped at 1100px.
  White 7px border, 20px radius. Reproduced exactly, with the numbers exposed
  as settings.

  The parent-side reCAPTCHA handshake the Easter section carries is dead code:
  that game never posts "request-recaptcha" — it renders its own v2 checkbox
  inside the iframe. Ours keeps the handshake because our game DOES use it
  (set `recaptcha: true`), and fixes the origin check, which compares against
  a full URL in the original and so can never match.
{% endcomment %}

<style>
  .mm-container{
    {% if section.settings.bg_image %}
      background-image:url({{ section.settings.bg_image | image_url: width: 2400 }});
      background-repeat:no-repeat; background-position:center; background-size:cover;
    {% else %}
      background:{{ section.settings.bg_color }};
    {% endif %}
  }
  .mm-wrap{
    align-items:center; display:flex; flex-direction:column;
    gap:5rem; padding:8rem 0 15rem;
  }
  .mm-frame{
    position:relative; overflow:hidden;
    width:{{ section.settings.width_pct }}%;
    max-width:{{ section.settings.max_width }}px;
    height:{{ section.settings.height_sm }}px;
  }
  @media (min-width:1152px){
    .mm-frame{ height:{{ section.settings.height_lg }}px; }
  }
  .mm-frame iframe{
    position:absolute; top:0; left:0; width:100%; height:100%;
    border:7px solid #FFF; border-radius:20px;
  }
</style>

{% if section.settings.recaptcha_key != blank %}
  <script src="https://www.google.com/recaptcha/api.js?render={{ section.settings.recaptcha_key }}"></script>
{% endif %}

<div class="mm-container">
<div class="mm-wrap">
  <div class="mm-frame">
    <iframe id="mm-game-{{ section.id }}"
            src="{{ section.settings.game_url }}{% if section.settings.game_url contains '?' %}&{% else %}?{% endif %}bg={{ section.settings.bg_color | remove: '#' }}"
            title="Chewbie's Mystery Mix-Up"
            allow="autoplay; web-share"
            allowfullscreen></iframe>
  </div>
</div>

<script>
(function(){
  // background is passed through so any letterbox inside the frame matches the page
  var BASE_URL  = {{ section.settings.game_url | json }};
  var BG        = {{ section.settings.bg_color | json }}.replace("#","");
  var GAME_URL  = BASE_URL ? BASE_URL + (BASE_URL.indexOf("?") > -1 ? "&" : "?") + "bg=" + BG : "";
  var SITE_KEY  = {{ section.settings.recaptcha_key | json }};
  var frame     = document.getElementById("mm-game-{{ section.id }}");
  if(!frame || !GAME_URL) return;

  var GAME_ORIGIN;
  try { GAME_ORIGIN = new URL(GAME_URL, window.location.href).origin; }
  catch(e){ return; }

  window.addEventListener("message", function(e){
    if (e.origin !== GAME_ORIGIN) return;   // origin, not URL — see comment above

    // reCAPTCHA v3: the frame asks, we execute, we post the token back.
    if (e.data === "request-recaptcha") {
      if (!SITE_KEY || typeof grecaptcha === "undefined") return;
      grecaptcha.ready(function(){
        grecaptcha.execute(SITE_KEY, { action: "mystery_mix_entry" })
          .then(function(token){
            frame.contentWindow.postMessage(
              { type: "recaptcha-token", token: token }, GAME_ORIGIN);
          });
      });
      return;
    }

    var m = e.data;
    if (!m || m.source !== "mystery-mix") return;

    if (m.type === "mix_created" && window.dataLayer) {
      window.dataLayer.push({
        event: "mystery_mix_created",
        mystery_mix_flavours: m.guess.join(" + ")
      });
    }

    if (m.type === "entry_submitted") {
      // Hand the entry to whoever captures it. Nothing here stores or sends
      // anything — wire this to Hulk Form Builder / Mailchimp / an endpoint.
      document.dispatchEvent(new CustomEvent("mystery-mix:entry", { detail: m.entry }));

      // If the capture side is wired up, acknowledge so the game advances:
      // frame.contentWindow.postMessage(
      //   { source:"mystery-mix-host", type:"entry_accepted" }, GAME_ORIGIN);
    }
  });
})();
</script>

{% schema %}
{
  "name": "Mystery Mix Game",
  "class": "mystery-mix-game",
  "settings": [
    {
      "type": "url",
      "id": "game_url",
      "label": "Game URL",
      "info": "The hosted game, e.g. https://multiply-dev.github.io/mystery-mix-up/"
    },
    {
      "type": "text",
      "id": "recaptcha_key",
      "label": "reCAPTCHA v3 site key",
      "info": "Leave blank to disable the captcha handshake."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#740494"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Full-bleed behind the game, as on the Easter page. Falls back to the colour."
    },
    {
      "type": "range",
      "id": "width_pct",
      "label": "Width of the page",
      "min": 40, "max": 100, "step": 2, "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600, "max": 1400, "step": 50, "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "height_sm",
      "label": "Frame height, under 1152px",
      "min": 500, "max": 1200, "step": 2, "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "height_lg",
      "label": "Frame height, 1152px and up",
      "min": 500, "max": 1200, "step": 2, "unit": "px",
      "default": 866
    }
  ],
  "presets": [{ "name": "Mystery Mix Game" }]
}
{% endschema %}
