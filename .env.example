# Mailchimp — from Account > Extras > API keys. The datacenter is the suffix
# after the dash in the key (e.g. ...-us21), so MAILCHIMP_DC is optional.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_DC=

# reCAPTCHA v3 server-side secret. Leave blank and captcha checking is skipped
# — the endpoint says so rather than pretending to verify.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Comma-separated. Blank allows any origin, which is fine only in development.
ALLOWED_ORIGINS=https://www.hi-chew.com,https://hi-chew.com

CAMPAIGN_TAG=mystery-mix-2026
